rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // профили игроков
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
    }

    // онлайн-партии и чат партии
    match /games/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.players.size() == 1
        && request.resource.data.players[0] == request.auth.uid;
      allow update: if signedIn() && (
        request.auth.uid in resource.data.players ||
        (resource.data.status == 'open'
          && request.auth.uid in request.resource.data.players
          && request.resource.data.players.size() == 2));
      match /messages/{id} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 500;
      }
    }

    // общий и личные чаты
    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create, update: if signedIn() && request.auth.uid in request.resource.data.members;
      match /messages/{id} {
        allow read: if signedIn() && (chatId == 'global' || request.auth.uid in chatId.split('_'));
        allow create: if signedIn()
          && (chatId == 'global' || request.auth.uid in chatId.split('_'))
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 500;
      }
    }
  }
}
